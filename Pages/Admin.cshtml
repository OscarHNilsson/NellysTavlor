@page
@model AdminModel
@{
    ViewData["Title"] = "Admin - Add Painting";
}

<h1>Add a Painting</h1>

<form method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label>Title</label>
        <input type="text" asp-for="Title" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Medium</label>
        <input type="text" asp-for="Medium" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Width (inches)</label>
        <input type="number" step="0.01" asp-for="Width" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Height (inches)</label>
        <input type="number" step="0.01" asp-for="Height" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Image</label>
        <input type="file" asp-for="ImageFile" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif" required />
    </div>

    <button type="submit" class="btn btn-primary">Add Painting</button>
</form>

@if (TempData["SuccessMessage"] != null)
{
    <p class="text-success mt-3">@TempData["SuccessMessage"]</p>
}
@if (TempData["ErrorMessage"] != null)
{
    <p class="text-danger mt-3">@TempData["ErrorMessage"]</p>
}

<hr class="my-4" />

<h2>Existing Paintings</h2>

<table class="table">
    <thead>
        <tr>
            <th>Image</th>
            <th>Title</th>
            <th>Medium</th>
            <th>Dimensions</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var painting in Model.ExistingPaintings)
        {
            <tr>
                <td><img src="@painting.ImagePath" style="width: 60px; height: 60px; object-fit: cover;" /></td>
                <td>@painting.Title</td>
                <td>@painting.Medium</td>
                <td>@painting.Width" x @painting.Height"</td>
                <td>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@painting.Id"
                          onsubmit="return confirm('Delete this painting?');">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
